        "# Experiment 7: Next-token probabilities - inspect logits and top-k candidates from a small open model (GPT-2)\n",
        "import torch\n",
        "import pandas as pd\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
        "\n",
        "tok = AutoTokenizer.from_pretrained(\"gpt2\")\n",
        "model = AutoModelForCausalLM.from_pretrained(\"gpt2\").eval()\n",
        "\n",
        "def top_k_next(prompt, k=5):\n",
        "    ids = tok(prompt, return_tensors=\"pt\").input_ids\n",
        "    with torch.no_grad():\n",
        "        logits = model(ids).logits[0, -1]          # scores for the NEXT token only\n",
        "    probs = torch.softmax(logits, dim=-1)          # logits -> probability distribution\n",
        "    p, idx = probs.topk(k)\n",
        "    return [{\"prompt\": prompt, \"rank\": r + 1, \"token\": repr(tok.decode(i)), \"token_id\": int(i),\n",
        "             \"logit\": round(float(logits[i]), 2), \"probability\": round(float(pp), 4)} for r, (pp, i) in enumerate(zip(p, idx))]\n",
        "\n",
        "prompts = [\"The capital of India is\", \"Machine learning is a subset of\", \"I drank a cup of\", \"The opposite of hot is\"]\n",
        "table = pd.DataFrame([row for pr in prompts for row in top_k_next(pr)])\n",
        "print(\"Probability table (top-5 next tokens):\")\n",
        "print(table.to_string(index=False))\n",
        "\n",
        "# Autoregressive generation, one token at a time (greedy) - shows that generation = repeated next-token prediction\n",
        "ids = tok(\"Generative AI is\", return_tensors=\"pt\").input_ids\n",
        "for step in range(8):\n",
        "    with torch.no_grad():\n",
        "        nxt = model(ids).logits[0, -1].argmax()\n",
        "    ids = torch.cat([ids, nxt.view(1, 1)], dim=1)\n",
        "    print(f\"step {step + 1}: {tok.decode(ids[0])!r}\")"
      ]
    }
